# ==========================================
# DocuMind AI - Environment Configuration
# ==========================================

# 1. LLM answer generation (Preferred: Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional legacy cloud paths; local embeddings/OCR are used by default.
USE_GEMINI_EMBEDDINGS=false
USE_GEMINI_OCR=false
# Optional fallback if using OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# 2. Supabase PostgreSQL & pgvector Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional settings
NEXT_PUBLIC_APP_NAME="DocuMind AI"
